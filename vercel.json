{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader && npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.1",
            "includeFiles": [
                "app/**",
                "bootstrap/**",
                "config/**",
                "resources/**",
                "routes/**",
                "vendor/**",
                "public/**"
            ]
        }
    },
    "rewrites": [
        { "source": "/(.*)", "destination": "/api/index.php" }
    ],
    "headers": [
        {
            "source": "/build/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
    ]
}
